{
  "title": "ThreadForge — Service Traffic & Signals",
  "uid": "tf-service-traffic",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Istio Requests (last 5m)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "expr": "sum(increase(istio_requests_total[5m]))",
          "legendFormat": "requests"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Istio 4xx/5xx Rate",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "expr": "sum(rate(istio_requests_total{response_code=~\"4..|5..\"}[5m])) or vector(0)",
          "legendFormat": "error rps"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Loki Up",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "expr": "up{job=~\"loki.*\"}",
          "legendFormat": "loki"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tempo Up",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "expr": "up{job=~\"tempo.*\"}",
          "legendFormat": "tempo"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Istio Request Rate by Destination",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "expr": "sum(rate(istio_requests_total[1m])) by (destination_workload, destination_workload_namespace)",
          "legendFormat": "{{destination_workload_namespace}}/{{destination_workload}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Istio Request Rate by Response Code",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "expr": "sum(rate(istio_requests_total[1m])) by (response_code)",
          "legendFormat": "HTTP {{response_code}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Istio P95 Request Latency (ms)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "expr": "histogram_quantile(0.95, sum(rate(istio_request_duration_milliseconds_bucket[1m])) by (le, destination_workload))",
          "legendFormat": "p95 {{destination_workload}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Istiod Control Plane — CSR Rate",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "expr": "rate(citadel_server_csr_count[1m])",
          "legendFormat": "cert issuance rate"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "expr": "rate(citadel_server_success_cert_issuance_count[1m])",
          "legendFormat": "success cert issuance rate"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Recent Logs — All Namespaces",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "${loki_ds}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki_ds}" },
          "expr": "{namespace=~\".+\"} | json | line_format \"{{.namespace}}/{{.pod}}: {{.message}}\"",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showLabels": true,
        "showlabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 10,
      "type": "traces",
      "title": "Recent Traces — Tempo",
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 10 },
      "datasource": { "type": "tempo", "uid": "${tempo_ds}" },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${tempo_ds}" },
          "queryType": "traceql",
          "query": "{}",
          "limit": 20
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "prom_ds",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Prometheus"
      },
      {
        "name": "loki_ds",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "label": "Loki"
      },
      {
        "name": "tempo_ds",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "hide": 0,
        "label": "Tempo"
      }
    ]
  }
}
