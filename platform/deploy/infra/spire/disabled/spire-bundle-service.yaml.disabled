{{- if .Values.bundleService.enabled }}
apiVersion: v1
kind: Service
metadata:
  name: spire-bundle
  namespace: spire-system
  labels:
    app: spire-bundle
spec:
  selector:
    app: spire-bundle
  ports:
  - name: https
    port: {{ .Values.bundleService.port | default 8443 }}
    targetPort: {{ .Values.bundleService.containerPort | default 80 }}
    protocol: TCP
  type: ClusterIP
{{- end }}
