{
  "uid": "minio-overview",
  "title": "MinIO Overview (Bitnami)",
  "tags": ["minio", "bitnami", "overview"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Uptime",
      "id": 1,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "description": "This metric is expected in a healthy system. 'No data' indicates missing instrumentation or scrape failure.",
      "targets": [
        {
          "expr": "time() - minio_node_uptime_seconds{job=\"minio\"}",
          "legendFormat": "MinIO Uptime"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total Buckets",
      "id": 2,
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": "Prometheus",
      "description": "This metric is expected in a healthy system. 'No data' indicates missing instrumentation or scrape failure.",
      "targets": [
        {
          "expr": "minio_bucket_usage_total{job=\"minio\"}",
          "legendFormat": "Total Buckets"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Online Drives",
      "id": 3,
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": "Prometheus",
      "description": "This metric is expected in a healthy system. 'No data' indicates missing instrumentation or scrape failure.",
      "targets": [
        {
          "expr": "sum(minio_cluster_disk_online{job=\"minio\"})",
          "legendFormat": "Drives Online"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Cluster Used Storage",
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "lines": true,
      "datasource": "Prometheus",
      "description": "This metric is expected in a healthy system. 'No data' indicates missing instrumentation or scrape failure.",
      "targets": [
        {
          "expr": "minio_cluster_usage_total_bytes{job=\"minio\"}",
          "legendFormat": "Used Storage"
        }
      ],
      "yaxes": [
        { "label": "Bytes", "format": "bytes" },
        { "label": "", "format": "short" }
      ]
    },
    {
      "type": "graph",
      "title": "Cluster Free Storage",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "lines": true,
      "datasource": "Prometheus",
      "description": "This metric is expected in a healthy system. 'No data' indicates missing instrumentation or scrape failure.",
      "targets": [
        {
          "expr": "minio_cluster_usage_free_bytes{job=\"minio\"}",
          "legendFormat": "Free Storage"
        }
      ],
      "yaxes": [
        { "label": "Bytes", "format": "bytes" },
        { "label": "", "format": "short" }
      ]
    }
  ]
}
