# syntax=docker/dockerfile:1

FROM golang:1.25-alpine AS builder

WORKDIR /workspace

ENV CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=arm64

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -o spire-csr ./cmd/spire-csr

FROM gcr.io/distroless/base-debian12

WORKDIR /
COPY --from=builder /workspace/spire-csr /spire-csr

USER 65532
ENTRYPOINT ["/spire-csr"]
